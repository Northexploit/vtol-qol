<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon Condition="Exists('icon.ico')">icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" Condition="Exists('icon.ico')" LogicalName="icon.ico" />
    <EmbeddedResource Include="tools\ffmpeg.exe" Condition="Exists('tools\ffmpeg.exe')" LogicalName="ffmpeg.exe" />
    <EmbeddedResource Include="tools\yt-dlp.exe" Condition="Exists('tools\yt-dlp.exe')" LogicalName="yt-dlp.exe" />
  </ItemGroup>
</Project>
